# Spoooky Deck: Apache (works at a domain root and in a subdirectory because all paths are relative)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType audio/mpeg .mp3
  AddType application/javascript .js
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Page, service worker, manifest and data: always revalidate
  <FilesMatch "(^sw\.js|\.html|\.webmanifest|\.json|\.css|\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Images and fonts also change in place, so revalidate (304 when unchanged); the service worker keeps an offline copy anyway
  <FilesMatch "\.(png|woff2|ttf)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Music is large and gets a new file name when the track changes: one day
  <FilesMatch "\.mp3$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
