{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "data/grammar.{pl,en}.json: gramatyka Tracery (symbol -> lista wariantow). Zmienne wstawiane przez oracle.js: #name#, #company#, #zodiac#, #keywords#, #meaning#, #business#, #omen#, #service#.",
  "type": "object",
  "required": ["origin", "wezwanie", "znaczenie", "omen", "puenta", "cta"],
  "additionalProperties": { "$ref": "#/$defs/rules" },
  "properties": {
    "origin": { "$ref": "#/$defs/rules" },
    "wezwanie": { "$ref": "#/$defs/rules" },
    "znaczenie": { "$ref": "#/$defs/rules" },
    "omen": { "$ref": "#/$defs/rules" },
    "puenta": { "$ref": "#/$defs/rules" },
    "cta": { "$ref": "#/$defs/rules" }
  },
  "$defs": {
    "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
