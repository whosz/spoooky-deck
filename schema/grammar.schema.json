{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "data/grammar.{pl,en}.json: a Tracery grammar. oracle.js injects: name, company, zodiac, card, pos, keywords, meaning, business, omen (from zodiac.json). The punchline is chosen by the card's service: puenta_<service>. Sentences about the company: branza_<it|handel|uslugi|produkcja|gastro|inne> and etap_<start|rozwoj|dojrzala|zmiana> (required, at least 3 variants each).",
  "type": "object",
  "required": [
    "origin",
    "wezwanie",
    "znaczenie",
    "cta",
    "puenta_identity",
    "puenta_uxui",
    "puenta_website",
    "puenta_startup",
    "branza_it",
    "branza_handel",
    "branza_uslugi",
    "branza_produkcja",
    "branza_gastro",
    "branza_inne",
    "etap_start",
    "etap_rozwoj",
    "etap_dojrzala",
    "etap_zmiana"
  ],
  "additionalProperties": {
    "$ref": "#/$defs/rules"
  },
  "properties": {
    "origin": {
      "$ref": "#/$defs/rules"
    },
    "wezwanie": {
      "$ref": "#/$defs/rules"
    },
    "znaczenie": {
      "$ref": "#/$defs/rules"
    },
    "cta": {
      "$ref": "#/$defs/rules"
    },
    "puenta_identity": {
      "$ref": "#/$defs/rules"
    },
    "puenta_uxui": {
      "$ref": "#/$defs/rules"
    },
    "puenta_website": {
      "$ref": "#/$defs/rules"
    },
    "puenta_startup": {
      "$ref": "#/$defs/rules"
    }
  },
  "$defs": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
